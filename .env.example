# ── MetaBot configuration ──────────────────────────────────────────
# All vars below are OPTIONAL. Copy this file to `.env` and uncomment
# the lines you want to override. Values are read by
# scripts/write-config.mjs and baked into config.js (window.METABOT_CONFIG).

# Custom Ethereum RPC endpoint used for reads, simulations, and mints.
# Defaults to a public node when unset.
# DEFAULT_RPC_URL=https://ethereum.publicnode.com

# Default "Max Gas" value (gwei) pre-filled in the gas controls.
# DEFAULT_MAX_GAS_GWEI=50

# Default "Priority Tip" value (gwei) pre-filled in the gas controls.
# DEFAULT_TIP_GWEI=2

# Enable Turbo Mode by default (aggressive gas, parallel sends).
# Accepts: true/false, 1/0, yes/no, on/off.
# TURBO_MODE_ENABLED=false
